{
  "permissions": {
    "allow": [
      "Bash(brew install:*)",
      "Bash(HOMEBREW_NO_AUTO_UPDATE=1 brew install pandoc)",
      "Bash(pandoc:*)",
      "Bash(make:*)",
      "Bash(grep:*)",
      "Bash(chmod:*)",
      "Bash(./convert_to_docx.sh:*)",
      "Bash(pdflatex -interaction=nonstopmode -halt-on-error main.tex)",
      "Bash(echo \"exit: $?\")",
      "Bash(mdls -name kMDItemNumberOfPages main.pdf)"
    ],
    "defaultMode": "acceptEdits"
  }
}
